{
  "name": "@push-based/angular-ssr-stream-nestjs",
  "version": "0.0.0",
  "description": "Streamed SSR for Angular in a NestJS app: a module that renders every page route on platform-express or platform-fastify, next to the app's controllers.",
  "keywords": [
    "angular",
    "ssr",
    "server-side-rendering",
    "streaming",
    "streaming-ssr",
    "streamed-ssr",
    "hydration",
    "incremental-hydration",
    "nestjs",
    "nest"
  ],
  "homepage": "https://push-based.github.io/angular-ssr-stream/docs/reference/nestjs",
  "bugs": {
    "url": "https://github.com/push-based/angular-ssr-stream/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/push-based/angular-ssr-stream.git",
    "directory": "packages/nestjs"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./vite": "./src/vite.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vp pack",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./vite": {
        "types": "./dist/vite.d.ts",
        "default": "./dist/vite.js"
      },
      "./package.json": "./package.json"
    }
  },
  "dependencies": {
    "@push-based/angular-ssr-stream-core": "workspace:*",
    "@push-based/angular-ssr-stream-node": "workspace:*"
  },
  "peerDependencies": {
    "@angular/core": "^19.2.22 || ^20.3.21 || ^21.2.13 || ^22.0.0 || ~22.3.0-rc.0",
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/platform-express": "^12.0.0",
    "@nestjs/platform-fastify": "^12.0.0",
    "@push-based/angular-ssr-stream-fastify": "workspace:*",
    "vite": ">=7"
  },
  "devDependencies": {
    "@angular/common": "22.3.0-rc.0",
    "@angular/core": "22.3.0-rc.0",
    "@angular/platform-browser": "22.3.0-rc.0",
    "@angular/platform-server": "22.3.0-rc.0",
    "@nestjs/common": "^12.6.0",
    "@nestjs/core": "^12.6.0",
    "@nestjs/platform-express": "^12.6.0",
    "@nestjs/platform-fastify": "^12.6.0",
    "@push-based/angular-ssr-stream-fastify": "workspace:*",
    "@types/node": "^20.19.43",
    "fastify": "5.12.8",
    "reflect-metadata": "^0.2.2",
    "rxjs": "~7.8.0",
    "typescript": "~6.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8001",
    "vite-plus": "1.8.0"
  },
  "nx": {
    "tags": [
      "type:package",
      "runtime:nestjs"
    ]
  },
  "peerDependenciesMeta": {
    "@nestjs/platform-express": {
      "optional": true
    },
    "@nestjs/platform-fastify": {
      "optional": true
    },
    "@push-based/angular-ssr-stream-fastify": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  }
}
