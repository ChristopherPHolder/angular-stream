/**
 * The demo Worker. Same setup as apps/movies: `html_handling: "none"` sends
 * every navigation to the Worker, which renders it into `/index.html`.
 */
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "angular-stream-demo",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-09-07",
  "assets": {
    "binding": "ASSETS",
    "html_handling": "none",
  },
  "observability": {
    "enabled": true,
  },
  "upload_source_maps": true,
}
