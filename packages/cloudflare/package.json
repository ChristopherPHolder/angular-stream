{
  "name": "@push-based/angular-ssr-stream-cloudflare",
  "version": "0.0.0",
  "description": "Streamed SSR for Angular on Cloudflare Workers: a Worker fetch handler over the ASSETS binding.",
  "keywords": [
    "angular",
    "ssr",
    "server-side-rendering",
    "streaming",
    "streaming-ssr",
    "streamed-ssr",
    "hydration",
    "incremental-hydration",
    "cloudflare",
    "cloudflare-workers",
    "workers"
  ],
  "homepage": "https://push-based.github.io/angular-ssr-stream/docs/reference/cloudflare",
  "bugs": {
    "url": "https://github.com/push-based/angular-ssr-stream/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/push-based/angular-ssr-stream.git",
    "directory": "packages/cloudflare"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vp pack",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "dependencies": {
    "@push-based/angular-ssr-stream-core": "workspace:*"
  },
  "peerDependencies": {
    "@angular/core": "^19.2.22 || ^20.3.21 || ^21.2.13 || ^22.0.0 || ~22.3.0-rc.0"
  },
  "devDependencies": {
    "@angular/common": "22.3.0-rc.0",
    "@angular/core": "22.3.0-rc.0",
    "@angular/platform-browser": "22.3.0-rc.0",
    "@angular/platform-server": "22.3.0-rc.0",
    "rxjs": "~7.8.0",
    "typescript": "~6.0.2",
    "vite-plus": "1.8.0"
  },
  "nx": {
    "tags": [
      "type:package",
      "runtime:cloudflare"
    ]
  }
}
