{
  "name": "@push-based/angular-ssr-stream-node",
  "version": "0.0.0",
  "description": "Streamed SSR for Angular on Node: a request handler for node:http, Express, Connect and every framework built on them.",
  "keywords": [
    "angular",
    "ssr",
    "server-side-rendering",
    "streaming",
    "streaming-ssr",
    "streamed-ssr",
    "hydration",
    "incremental-hydration",
    "node",
    "express",
    "connect",
    "koa",
    "vite-plugin"
  ],
  "homepage": "https://push-based.github.io/angular-ssr-stream/docs/reference/node",
  "bugs": {
    "url": "https://github.com/push-based/angular-ssr-stream/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/push-based/angular-ssr-stream.git",
    "directory": "packages/node"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./vite": "./src/vite.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vp pack",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./vite": {
        "types": "./dist/vite.d.ts",
        "default": "./dist/vite.js"
      },
      "./package.json": "./package.json"
    }
  },
  "dependencies": {
    "@push-based/angular-ssr-stream-core": "workspace:*"
  },
  "peerDependencies": {
    "@angular/core": "^19.2.22 || ^20.3.21 || ^21.2.13 || ^22.0.0 || ~22.3.0-rc.0",
    "vite": ">=7"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@angular/common": "22.3.0-rc.0",
    "@angular/core": "22.3.0-rc.0",
    "@angular/platform-browser": "22.3.0-rc.0",
    "@angular/platform-server": "22.3.0-rc.0",
    "@types/node": "^20.19.43",
    "rxjs": "~7.8.0",
    "typescript": "~6.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8001",
    "vite-plus": "1.8.0"
  },
  "nx": {
    "tags": [
      "type:package",
      "runtime:node"
    ]
  }
}
