{
  "name": "@push-based/angular-ssr-stream-fastify",
  "version": "0.0.0",
  "description": "Streamed SSR for Angular on Fastify: a plugin that renders every page route and streams it through Fastify's reply.",
  "keywords": [
    "angular",
    "ssr",
    "server-side-rendering",
    "streaming",
    "streaming-ssr",
    "streamed-ssr",
    "hydration",
    "incremental-hydration",
    "fastify",
    "fastify-plugin"
  ],
  "homepage": "https://push-based.github.io/angular-ssr-stream/docs/reference/fastify",
  "bugs": {
    "url": "https://github.com/push-based/angular-ssr-stream/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/push-based/angular-ssr-stream.git",
    "directory": "packages/fastify"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vp pack",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "dependencies": {
    "@push-based/angular-ssr-stream-core": "workspace:*",
    "@push-based/angular-ssr-stream-node": "workspace:*"
  },
  "peerDependencies": {
    "@angular/core": "^19.2.22 || ^20.3.21 || ^21.2.13 || ^22.0.0 || ~22.3.0-rc.0",
    "fastify": "^5.0.0"
  },
  "devDependencies": {
    "@angular/common": "22.3.0-rc.0",
    "@angular/core": "22.3.0-rc.0",
    "@angular/platform-browser": "22.3.0-rc.0",
    "@angular/platform-server": "22.3.0-rc.0",
    "@types/node": "^20.19.43",
    "fastify": "5.12.8",
    "rxjs": "~7.8.0",
    "typescript": "~6.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8001",
    "vite-plus": "1.8.0"
  },
  "nx": {
    "tags": [
      "type:package",
      "runtime:fastify"
    ]
  }
}
