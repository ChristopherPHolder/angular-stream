{
  "name": "angular-stream",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w movies",
    "build": "npm run build --workspaces --if-present"
  },
  "packageManager": "npm@11.13.0",
  "devDependencies": {
    "prettier": "^3.8.1"
  },
  "engines": {
    "node": ">=26"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261101.1": true,
    "workerd@1.20261104.1": true,
    "@parcel/watcher@2.6.0": true,
    "fsevents@2.3.3": true
  }
}
