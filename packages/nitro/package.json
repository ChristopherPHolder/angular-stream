{
  "name": "@push-based/angular-ssr-stream-nitro",
  "version": "0.0.0",
  "description": "Streamed SSR for Angular on Nitro: an h3 handler and a Vite plugin, deployable to every host Nitro has a preset for.",
  "keywords": [
    "angular",
    "ssr",
    "server-side-rendering",
    "streaming",
    "streamed-ssr",
    "hydration",
    "incremental-hydration",
    "nitro",
    "h3",
    "vite-plugin"
  ],
  "homepage": "https://push-based.github.io/angular-ssr-stream/docs/reference/nitro",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/push-based/angular-ssr-stream.git",
    "directory": "packages/nitro"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./vite": "./src/vite.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vp pack",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./vite": {
        "types": "./dist/vite.d.ts",
        "default": "./dist/vite.js"
      },
      "./package.json": "./package.json"
    }
  },
  "dependencies": {
    "@push-based/angular-ssr-stream-core": "workspace:*"
  },
  "peerDependencies": {
    "@angular/core": "~22.3.0-rc.0",
    "nitro": "3.0.261103-rc",
    "unstorage": "^2.0.0-beta.0",
    "vite": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@angular/common": "22.3.0-rc.0",
    "@angular/core": "22.3.0-rc.0",
    "@angular/platform-browser": "22.3.0-rc.0",
    "@angular/platform-server": "22.3.0-rc.0",
    "@types/node": "^20.19.43",
    "nitro": "3.0.261103-rc",
    "rxjs": "~7.8.0",
    "typescript": "~6.0.2",
    "unstorage": "2.0.0-beta.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8001",
    "vite-plus": "1.8.0"
  },
  "nx": {
    "tags": [
      "type:package",
      "runtime:nitro"
    ]
  }
}
